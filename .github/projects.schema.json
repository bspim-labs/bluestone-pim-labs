{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["name", "description", "status"],
    "anyOf": [
      { "required": ["github"] },
      { "required": ["url"] }
    ],
    "additionalProperties": false,
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "description": { "type": "string", "minLength": 1 },
      "url": { "type": "string", "pattern": "^https://" },
      "github": { "type": "string", "pattern": "^https://github\\.com/", "minLength": 1 },
      "status": { "type": "string", "enum": ["live", "beta", "wip", "archived"] },
      "cta": { "type": "string", "minLength": 1 },
      "author": { "type": "string", "minLength": 1 },
      "authorUrl": { "type": "string", "pattern": "^https://" },
      "icon": { "type": "string", "enum": ["terminal", "template", "builder", "skill", "browser", "default"] },
      "logo": {
        "oneOf": [
          { "const": "github" },
          { "type": "string", "pattern": "^https://" }
        ]
      },
      "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "details": { "type": "string", "minLength": 1 },
      "screenshots": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": {
          "type": "object",
          "required": ["src", "alt"],
          "additionalProperties": false,
          "properties": {
            "src": { "type": "string", "pattern": "^(https://|/public/projects/)" },
            "alt": { "type": "string", "minLength": 1 },
            "caption": { "type": "string", "minLength": 1 }
          }
        }
      },
      "requestOnly": { "type": "boolean" },
      "requestEmail": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" }
    },
    "if": {
      "properties": { "requestOnly": { "const": true } },
      "required": ["requestOnly"]
    },
    "then": { "required": ["requestEmail"] }
  }
}
